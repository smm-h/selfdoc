{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selfdoc check output",
  "type": "object",
  "required": ["directives", "coverage", "lints", "exit_code"],
  "properties": {
    "directives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "directive", "status", "error"],
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "directive": {"type": "string"},
          "status": {"type": "string", "enum": ["OK", "FAILED"]},
          "error": {"type": "string"}
        }
      }
    },
    "coverage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "total_public", "referenced", "documented",
            "referenced_symbols", "documented_symbols", "unreferenced_symbols"
          ],
          "properties": {
            "total_public": {"type": "integer", "minimum": 0},
            "referenced": {"type": "integer", "minimum": 0},
            "documented": {"type": "integer", "minimum": 0},
            "referenced_symbols": {"type": "array", "items": {"type": "string"}},
            "documented_symbols": {"type": "array", "items": {"type": "string"}},
            "unreferenced_symbols": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "lints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "code", "message", "severity"],
        "properties": {
          "file": {"type": "string"},
          "line": {"oneOf": [{"type": "integer"}, {"type": "null"}]},
          "code": {
            "type": "string",
            "enum": [
              "CLI001", "CLI002",
              "DQ001", "DQ002", "DQ003",
              "DRIFT001",
              "EXAMPLE001", "EXAMPLE002", "EXAMPLE003",
              "LANG001",
              "LINK001",
              "PARAM001",
              "POST001", "POST002", "POST003", "POST004", "POST005",
              "POST006", "POST007",
              "RETURN001",
              "SEARCH001",
              "SEO001", "SEO002", "SEO003", "SEO004", "SEO006", "SEO007",
              "SEO008", "SEO009", "SEO010", "SEO011", "SEO012", "SEO013",
              "SEO014", "SEO015",
              "STALE001", "STALE002",
              "UNIFIED001", "UNIFIED002",
              "VER001", "VER002", "VER003", "VER004",
              "XREF001", "XREF002"
            ]
          },
          "message": {"type": "string"},
          "severity": {"type": "string", "enum": ["error", "warning"]}
        }
      }
    },
    "exit_code": {"type": "integer", "enum": [0, 1]}
  }
}

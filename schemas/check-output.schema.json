{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selfdoc check output",
  "type": "object",
  "required": ["directives", "coverage", "lints", "exit_code"],
  "properties": {
    "directives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "directive", "status", "error"],
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "directive": {"type": "string"},
          "status": {"type": "string", "enum": ["OK", "FAILED"]},
          "error": {"type": "string"}
        }
      }
    },
    "coverage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["total_public", "referenced", "referenced_symbols", "unreferenced_symbols"],
          "properties": {
            "total_public": {"type": "integer", "minimum": 0},
            "referenced": {"type": "integer", "minimum": 0},
            "referenced_symbols": {"type": "array", "items": {"type": "string"}},
            "unreferenced_symbols": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "lints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "code", "message", "severity"],
        "properties": {
          "file": {"type": "string"},
          "line": {"oneOf": [{"type": "integer"}, {"type": "null"}]},
          "code": {
            "type": "string",
            "enum": ["SEO001", "SEO002", "SEO003", "SEO004", "SEO006", "SEO007", "SEO008", "SEO009", "SEO010", "SEO011", "SEO012", "SEO013", "SEO014", "SEO015", "STALE001"]
          },
          "message": {"type": "string"},
          "severity": {"type": "string", "enum": ["error", "warning"]}
        }
      }
    },
    "exit_code": {"type": "integer", "enum": [0, 1]}
  }
}

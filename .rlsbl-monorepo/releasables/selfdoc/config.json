{
  "changelog_format_version_enforced": true,
  "publish_mode": "ci",
  "push_timeout": 120,
  "env_file": "~/Projects/.env",
  "publish_gate_check_regex": "^(root-ci) / ",
  "targets": [
    "go"
  ],
  "pipelines": {
    "go": {
      "type": "go",
      "local": false,
      "target": "go",
      "artifact": "binary",
      "install_paths": [
        "./cmd/selfdoc"
      ]
    }
  },
  "batch_limits": {
    "exclusions": [
      {
        "reason": "non-user-facing batch",
        "entries": [
          {
            "version": "unreleased",
            "line": 2
          }
        ]
      },
      {
        "reason": "non-user-facing batch",
        "entries": [
          {
            "version": "unreleased",
            "line": 3
          }
        ]
      },
      {
        "reason": "non-user-facing batch",
        "entries": [
          {
            "version": "unreleased",
            "line": 4
          }
        ]
      },
      {

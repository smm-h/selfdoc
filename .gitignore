# Build output
dist/
# Anchored: the release artifact directory is the one at the repository root,
# and an unanchored pattern also matched the Go build pipeline's package at
# internal/build/.
/build/

# Node
node_modules/
npm-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docs build output
docs/_build/

# Wrangler
.wrangler/

# rlsbl
.rlsbl-notes-*.tmp
.rlsbl/lock
.credentials.json
.*-cache.json
.env
.env.local
*.local-only

*.log
coverage/

.rlsbl-monorepo/lock

# Go build output -- except the npm launcher stub, which is a tracked
# source file the wrapper package ships.
/bin/*
!/bin/launcher.cjs

# fleet-diff scratch root (clones, snapshots, normalized trees, report)
/.fleet-diff/

# uv/virtualenv
/.venv/

{
  "defaults": {
    "app": {
      "env_prefix": null,
      "config": false,
      "global_flags": [],
      "commands": {},
      "groups": {},
      "deprecated": {}
    },
    "flag": {
      "short": null,
      "default": null,
      "env": null,
      "choices": null,
      "repeatable": false,
      "negatable": null,
      "hidden": false
    },
    "arg": {
      "required": true,
      "variadic": false
    },
    "command": {
      "passthrough": false,
      "flags": [],
      "args": []
    },
    "group": {
      "commands": {},
      "groups": {},
      "deprecated": {}
    }
  },
  "project_id": "selfdoc",
  "name": "selfdoc",
  "version": "0.14.0",
  "help": "Code-aware static site generator with directive-based content extraction",
  "commands": {
    "init": {
      "name": "init",
      "help": "Initialize selfdoc in the current project",
      "flags": [
        {
          "name": "no-commit",
          "type": "bool",
          "help": "Skip auto-committing changed files",
          "default": false,
          "negatable": true
        }
      ]
    },
    "build": {
      "name": "build",
      "help": "Build the documentation site",
      "flags": [
        {
          "name": "no-commit",
          "type": "bool",
          "help": "Skip auto-committing changed files",
          "default": false,
          "negatable": true
        },
        {
          "name": "locale",
          "type": "str",
          "help": "Build only this locale (e.g., 'en')",
          "default": ""
        },
        {
          "name": "version",
          "type": "str",
          "help": "Build only this version (e.g., '1.0.0')",
          "default": ""
        }
      ]
    },
    "serve": {
      "name": "serve",
      "help": "Serve the documentation site locally",
      "flags": [
        {
          "name": "port",
          "type": "int",
          "help": "Port to serve on (default: 8000)",
          "short": "p",
          "default": 8000
        }
      ]
    },
    "deploy": {
      "name": "deploy",
      "help": "Deploy the documentation site"
    },
    "check": {
      "name": "check",
      "help": "Check documentation coverage and consistency",
      "flags": [
        {
          "name": "ignore",
          "type": "str",
          "help": "Comma-separated SEO codes to suppress (e.g., SEO007,SEO008)",
          "default": ""
        },
        {
          "name": "format",
          "type": "str",
          "help": "Output format (default: text)",
          "default": "text",
          "choices": [
            "text",
            "json"
          ]
        },
        {
          "name": "no-commit",
          "type": "bool",
          "help": "Skip auto-committing changed files",
          "default": false,
          "negatable": true
        },
        {
          "name": "dry-run",
          "type": "bool",
          "help": "Report staleness without writing hashes",
          "default": false,
          "negatable": true
        }
      ]
    },
    "gen": {
      "name": "gen",
      "help": "Auto-generate documentation pages from project structure",
      "flags": [
        {
          "name": "no-commit",
          "type": "bool",
          "help": "Skip auto-committing changed files",
          "default": false,
          "negatable": true
        }
      ]
    },
    "gen-data": {
      "name": "gen-data",
      "help": "Generate data files by running sandboxed scripts",
      "flags": [
        {
          "name": "no-commit",
          "type": "bool",
          "help": "Skip auto-committing changed files",
          "default": false,
          "negatable": true
        }
      ]
    }
  }
}

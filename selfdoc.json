{
  "version": "0.37.0",
  "source": [
    {
      "path": "selfdoc/",
      "language": "python"
    }
  ],
  "docs": "docs/",
  "output": "docs/_build/",
  "changelog": ".rlsbl-monorepo/releasables/selfdoc/CHANGELOG.md",
  "base_url": "https://selfdoc.smmh.dev",
  "author": {
    "name": "SMMH",
    "url": "https://smmh.dev",
    "same_as": [
      "https://github.com/smm-h"
    ]
  },
  "versions": [
    {
      "version": "0.37.0"
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "description": "Code-aware static site generator that resolves directive blocks in Markdown templates into live content extracted from source code.",
  "search_engine": "pagefind",
  "gen": {
    "exclude": [
      "selfdoc.staleness",
      "selfdoc.git",
      "selfdoc.catalog",
      "selfdoc.content",
      "selfdoc.extractors.base",
      "selfdoc.extractors.protocol",
      "selfdoc.themes"
    ]
  },
  "directives": {
    "catalog": "scripts/catalog-directive.py",
    "config-schema": "scripts/config-schema-directive.py"
  },
  "gen_data": {
    "scripts": [
      {
        "command": "python3 scripts/gen-directive-stats.py",
        "output": "directive-stats.json",
        "mounts": [
          "selfdoc_core/",
          "scripts/"
        ]
      }
    ]
  },
  "root_files": [
    "docs/_CLAUDE.md",
    "docs/_README.md"
  ],
  "branding": {
    "tagline": "Your code is the documentation.",
    "cta_text": "Get Started",
    "cta_link": "getting-started/",
    "features": [
      {
        "title": "Code-Aware Directives",
        "description": "Embed live API references, schemas, tests, and CLI help directly from source code. Content stays in sync automatically."
      },
      {
        "title": "Multi-Language Support",
        "description": "Python (AST-based), Go, and TypeScript extractors handle all five built-in directive types out of the box."
      },
      {
        "title": "Pure Python",
        "description": "Two direct runtime dependencies, both pure Python, nothing to compile. No JavaScript frameworks, no build tools, no configuration overhead."
      },
      {
        "title": "SEO & AI Optimized",
        "description": "Structured data, meta tags, sitemaps, llms.txt, Atom feeds, and 50+ SEO best practices built into every generated page."
      },
      {
        "title": "Themeable & Accessible",
        "description": "Two built-in themes with dark mode, WCAG AA contrast, print stylesheets, and full keyboard navigation."
      }
    ]
  },
  "topology": {
    "slug": "selfdoc",
    "docs_base": "https://smmh.dev",
    "posts_base": "https://smmh.dev/blog",
    "legacy_blog_host": "blog.smmh.dev",
    "projects": {
      "pixelweaver": "https://smmh.dev/pixelweaver",
      "claudestream": "https://smmh.dev/claudestream",
      "claudewheel": "https://smmh.dev/claudewheel",
      "go-toml-edit": "https://smmh.dev/go-toml-edit",
      "howmuchleft": "https://smmh.dev/howmuchleft",
      "orxtra": "https://smmh.dev/orxtra",
      "pgdesign": "https://smmh.dev/pgdesign",
      "predraw": "https://smmh.dev/predraw",
      "rlsbl": "https://smmh.dev/rlsbl",
      "safegit": "https://smmh.dev/safegit",
      "saferm": "https://smmh.dev/saferm",
      "strictcli": "https://smmh.dev/strictcli",
      "wesktop": "https://smmh.dev/wesktop"
    }
  },
  "posts": {
    "repo": "smm-h/posts"
  },
  "assembly": {
    "repo": "smm-h/selfdoc-cache",
    "pages_project": "smmh"
  }
}
